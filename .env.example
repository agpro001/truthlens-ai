# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# AWS Bedrock Configuration (Optional)
# Set this to your AWS Lambda function URL that invokes Bedrock
# Example: https://abc123xyz.lambda-url.us-east-1.on.aws/
AWS_BEDROCK_LAMBDA_URL=""

# This should be set as an environment variable in your Supabase project
# Not in the frontend .env file (kept here for reference only)
# LOVABLE_API_KEY=""
